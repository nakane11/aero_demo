<launch>
  <!-- マーカー認識 (AprilTag) -->
  <arg name="camera_name" default="/camera/color" />
  <arg name="image_topic" default="image_raw/decompressed" />

  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag_node" clear_params="true" output="screen">
    <remap from="image_rect" to="$(arg camera_name)/$(arg image_topic)" />
    <!-- CameraSubscriber が自動で付ける camera_info のパスを remap -->
    <remap from="$(arg camera_name)/image_raw/camera_info" to="$(arg camera_name)/camera_info" />
    <param name="publish_tag_detections_image" type="bool" value="true" />
    <param name="publish_tf" type="bool" value="true" />
    <rosparam command="load" file="$(find aero_demo)/config/tags.yaml" />
  </node>

  <!-- キャリブレーション (easy_handeye) -->
  <include file="$(find easy_handeye)/launch/calibrate.launch">
    <!-- カメラは頭に固定 -->
    <arg name="eye_on_hand" value="false" />
    <arg name="robot_base_frame" value="head_link" />     <!-- カメラ固定リンク -->
    <arg name="robot_effector_frame" value="l_forearm_link" /> <!-- マーカーを貼るリンク -->

    <arg name="tracking_base_frame" value="camera_color_optical_frame" />
    <arg name="tracking_marker_frame" value="tag_456" />

    <arg name="freehand_robot_movement" value="true" />
  </include>
</launch>
