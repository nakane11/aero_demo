<launch>
  <!-- print_palm_positions.py の骨格 (skeleton_markers) を点群と一緒に rviz で見る。
       aero_bringup.launch と print_palm_positions.py は別途起動すること。 -->
  <include file="$(find aero_demo)/launch/decompress.launch" />

  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find aero_demo)/rviz/skeleton_demo.rviz" />
</launch>
