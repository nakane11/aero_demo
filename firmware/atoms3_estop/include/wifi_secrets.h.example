// このファイルを wifi_secrets.h という名前でこの include/ ディレクトリに
// コピーして値を書き換える。wifi_secrets.h 自体は .gitignore で
// コミット対象外にしてあるので、実際の SSID/パスワードや PC の IP を
// ここに書いても git 管理には乗らない。
//
//   cp include/wifi_secrets.h.example include/wifi_secrets.h

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// estop_node.py (rosrun aero_demo estop_node.py) を動かしている PC の
// IP アドレス。ポートは estop_node.py 側の --listen-port 既定値
// (5555) に合わせて src/main.cpp 側の ESTOP_PORT を使う。
#define ESTOP_NODE_HOST "192.168.xxx.xxx"
